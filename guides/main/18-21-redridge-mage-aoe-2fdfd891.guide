  goto 34.599928,82.990312 map 1433 r 50 optional
  goto 43.439848,71.109788 map 1433 r 50 optional
  goto 29.510179,84.169938 map 1433 r 50 optional
  goto 34.599928,82.990312 map 1433 r 50 optional
